---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Decoration from '../components/Decoration.astro';
import Products from '../components/Products.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Contact from '../components/Contact.astro';
---

<Layout title="KathCraft" description='pSomos un centro creativo, desarrollamos ideas y las convertimos en realidad. Utilizamos maquinado CNC, impresión 3D y diseño asistido por computador para crear productos adaptados a tu necesidad.'>
	<main>			  
		<SectionContainer id="inicio">
			<Hero>
			<Hero />
		</SectionContainer>
		<SectionContainer id="decoracion">
			<Decoration>
			<Decoration />
		</SectionContainer>
		<SectionContainer id="seccion-productos">
			<Products>
			<Products />
		</SectionContainer>
		<SectionContainer id="servicios">
			<Services>
			<Services />
		</SectionContainer>
		<SectionContainer id="contacto">
			<Contact>
			<Contact />
		</SectionContainer>
		
	</main>
</Layout>