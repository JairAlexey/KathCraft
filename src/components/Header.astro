---
import ThemeToggle from "./ThemeToggle.astro";
import Cart from "./icons/Cart.astro";
import Menu from "./icons/Menu.astro";

const navItems = [
  { title: "Inicio", label: "inicio", url: "/#inicio" },
  { title: "Productos", label: "productos", url: "/productos" },
  { title: "Servicios", label: "servicios", url: "/#servicios" },
  { title: "Contacto", label: "contacto", url: "/#contacto" },
];

const currentPath = Astro.url.pathname;

function isActive(url: string) {
  if (url === "/#inicio") {
    return currentPath === "/" || currentPath === "/#inicio";
  }
  return currentPath.startsWith(url);
}
---

<header class="fixed top-0 z-10 w-full py-4 px-2 sm:px-4 md:px-40">
  <nav class="flex items-center justify-between w-full mx-auto px-2 sm:px-4 py-2 max-w-7xl rounded-full bg-gray-800 shadow-lg relative">
    <!-- Logo -->
    <a href="/#inicio" class="flex items-center flex-shrink-0">
      <img 
        src="/Logo.svg" 
        alt="Logo" 
        class="h-7 sm:h-8 md:h-11 mr-1 sm:mr-2" 
        width="36" 
        height="36"
        loading="eager"
      >
      <span class="text-red text-lg sm:text-xl md:text-xl font-semibold">KathCraft</span>
    </a>
    
    <!-- Navigation Links -->
    <div class="hidden md:flex flex-grow justify-end items-center space-x-2 font-medium text-base">
      {navItems.map((link) => (
        <a
          class={`relative px-2 py-2 transition hover:text-red-500 active:text-red-500 focus:text-red-500 ${isActive(link.url) ? 'text-red-500' : ''}`}
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))}
    </div>

    <!-- Separator Line (visible only on large screens) -->
    <div class="hidden md:block w-px h-8 bg-gray-600 mx-4"></div>    
    
    <!-- Mobile Icons Container -->
    <div class="flex items-center space-x-3">
      <!-- Cart Icon with Badge -->
      <div class="relative">
        <a href="/cart">
          <button
            id="cart-button"
            class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 active:bg-gray-300 dark:active:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-300 dark:focus:ring-gray-600 transition-colors duration-200 group"
            aria-label="Carrito de compras"
          >
            <Cart width="24" height="24" class="text-black dark:text-white group-hover:text-red-600 dark:group-hover:text-red-600 group-active:text-red-600 dark:group-active:text-red-600" />
            <span
              id="cart-count"
              class="absolute -top-1 -right-1 bg-red-600 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center"
              aria-label="Cantidad de productos en el carrito"
            >0</span>
          </button>
        </a>
      </div>

      <!-- Theme Toggle -->
      <div class="relative">

        <ThemeToggle />
      </div>

      <!-- Dropdown Menu Button -->
      <div class="relative md:hidden">
        <button
          id="dropdownToggle"
          class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 active:bg-gray-300 dark:active:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-300 dark:focus:ring-gray-600 transition-colors duration-200"
          type="button"
          aria-label="Menú desplegable"
          
        >
          <Menu width="24" height="24" />
        </button>

        <!-- Dropdown menu -->
          <div
          id="dropdownMenu"
          class="absolute hidden scale-80 top-12 right-0 text-base p-1 min-w-[8rem] rounded-md border border-gray-100 bg-white/90 dark:bg-gray-900/90 dark:border-gray-500/20 shadow-[0_3px_10px_rgb(0,0,0,0.2)] backdrop-blur-md"
        >
          <ul>
            {navItems.map((item) => (
              <li>
                <a
                  href={item.url}
                  class={`block px-2 py-1.5 cursor-default hover:bg-neutral-400/40 dark:hover:bg-gray-500/50 rounded-sm ${isActive(item.url) ? 'text-red-500' : ''}`}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </nav>
</header>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply dark:bg-gray-800/90 bg-white/50;
  }

  @keyframes nav-shadown {
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>