---
import Tab from "./Tab.astro";
import StrongIconCart from "./icons/StrongIconCart.astro";
import { productos, categorias, normalizarID } from "../data/products"
import CartButton from "./CartButton.astro";


// Función auxiliar para obtener la primera imagen
const getPrimeraImagen = (producto: any) => {
  if (producto.imagenes && producto.imagenes.length > 0) {
    return producto.imagenes[0];
  }
  return producto.imagen || ''; // Fallback a la propiedad imagen antigua o una cadena vacía
};
---

<Tab />

{
  categorias.map((categoria) => (
    <section class="text-gray-600 body-font pt-20" id={normalizarID(categoria)}>
      <div class="lg:w-1/2 w-full mb-1 lg:mb-0 p-5">
        <h2 class="sm:text-3xl text-2xl font-medium title-font mb-2 text-dark dark:text-white">
          {categoria}
        </h2>
        <div class="h-1 w-20 bg-red-600 rounded" />
      </div>
      <div class="container px-5 py-24 mx-auto">
        <div class="flex flex-wrap -m-4">
          {productos
            .filter((producto) => producto.categoria === categoria)
            .map((producto) => (
              <div class="lg:w-1/4 md:w-1/2 p-4 w-full">
                <a
                  href={`/producto/${normalizarID(producto.nombre)}`}
                  class="block relative rounded overflow-hidden transition-all duration-300 hover:shadow-lg focus:shadow-lg active:scale-95"
                  style="aspect-ratio: 4 / 3;"
                >
                  <img
                    alt={producto.nombre}
                    class="object-cover object-center w-full h-full block transition-transform duration-300 hover:scale-105 focus:scale-105"
                    src={getPrimeraImagen(producto)}
                    sizes="(max-width: 640px) 100vw, (max-width: 768px) 50vw, 25vw"
                    loading="lazy"
                    width="900"
                    height="675"
                  />
                  <div class="absolute inset-0 bg-black bg-opacity-0 hover:bg-opacity-10 focus:bg-opacity-10 transition-opacity duration-300"></div>
                </a>
                <div class="mt-4">
                  <p class="text-dark dark:text-white text-xs tracking-widest title-font mb-1">
                    {producto.material}
                  </p>
                  <a 
                    href={`/producto/${normalizarID(producto.nombre)}`}
                    class="group transition-colors duration-300"
                  >
                    <h3 class="text-dark dark:text-white text-lg font-medium group-hover:text-red-600 group-focus:text-red-600 transition-colors duration-300">
                      {producto.nombre}
                    </h3>
                  </a>
                  <div class="flex items-center space-x-4 mt-1">
                    <p class="text-dark dark:text-white">{producto.precio}</p>
                    <button
                      type="button"
                      class="add-to-cart-btn text-white bg-red-600 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800"
                      data-product={producto.nombre}
                      data-precio={producto.precio}
                      data-imagen={producto.imagen}
                      data-material={producto.material}
                      data-url={`/producto/${normalizarID(producto.nombre)}`}
                    >
                      <StrongIconCart />
                      <span class="button-text">Agregar</span>
                    </button>
                  </div>
                </div>
              </div>
            ))}
        </div>
      </div>
    </section>
  ))
}

<CartButton />


<style>
  .animate-bounce {
    animation: bounce 1s infinite;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  @media (hover: hover) {
    a:hover h3 {
      text-decoration: underline;
    }
  }

  @media (hover: none) {
    a:active h3 {
      text-decoration: underline;
    }
  }
</style>