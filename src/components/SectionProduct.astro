---
import CartButton from "./CartButton.astro";
import StrongIconCart from "./icons/StrongIconCart.astro";
import WhatsappIcon from "./icons/Whatsapp.astro";
const { producto } = Astro.props;
import { normalizarID } from "../data/products";
import { Image } from "astro:assets";
const carouselId = `carousel-${normalizarID(producto.nombre)}`;

const sendWhatsAppMessage = () => {
    const phoneNumber = "5930999109597";
    const message = `Hola! Estoy interesado en el siguiente producto:\n\nNombre: ${producto.nombre}\nPrecio: ${producto.precio}\nURL: ${Astro.url.href}`;
    const encodedMessage = encodeURIComponent(message);
    return `https://wa.me/${phoneNumber}?text=${encodedMessage}`;
};
---

<section class="text-gray-600 body-font overflow-hidden py-5">


    <!-- Product details -->

    <div class="container px-5 py-24 mx-auto">
        <div class="lg:w-4/5 mx-auto flex flex-wrap">
            <div class="lg:w-1/2 w-full lg:pr-10 lg:py-6 mb-6 lg:mb-0">
                    <!-- Breadcrumb -->
                <nav class="py-5" aria-label="Breadcrumb">
                    <ol class="flex items-center gap-1 text-sm text-gray-600 dark:text-gray-400">
                        <li>
                            <a href="/#inicio" class="block transition hover:text-gray-900 dark:text-gray-100">
                                <span class="sr-only"> Inicio </span>

                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    class="size-4"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                                    ></path>
                                </svg>
                            </a>
                        </li>

                        <li class="rtl:rotate-180">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="size-4"
                                viewBox="0 0 20 20"
                                fill="currentColor"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                    clip-rule="evenodd"></path>
                            </svg>
                        </li>

                        <li>
                            <a href="/productos" class="block transition hover:text-gray-700 dark:text-gray-100">
                                Productos
                            </a>
                        </li>
                    </ol>
                </nav>
                <h1
                    class="text-gray-900 dark:text-white text-3xl title-font font-medium mb-4"
                >
                    {producto.nombre}
                </h1>
                <div class="flex mb-4">
                    <a
                        class="flex-grow text-red-600 border-b-2 border-red-600 py-2 text-lg px-1"
                        >Descripción</a
                    >
                </div>
                <p
                    class="leading-relaxed mb-4 descripcion text-gray-500 dark:text-gray-300"
                >
                    {producto.descripcion}
                </p>
                <div class="flex border-t border-gray-200 py-2">
                    <span class="text-gray-500 dark:text-gray-300"
                        >Categoría</span
                    >
                    <span
                        class="ml-auto text-dark dark:text-white font-semibold"
                        >{producto.categoria}</span
                    >
                </div>
                <div class="flex border-t border-gray-200 py-2">
                    <span class="text-gray-500 dark:text-gray-300"
                        >Material</span
                    >
                    <span
                        class="ml-auto text-dark dark:text-white font-semibold"
                        >{producto.material}</span
                    >
                </div>
                <div
                    class="flex ml-auto space-x-4 items-center justify-between"
                >
                    <span
                        class="title-font text-2xl text-dark dark:text-white font-semibold precio"
                    >
                        {producto.precio}
                    </span>
                    <div class="flex space-x-4">
                        <button
                            type="button"
                            class="add-to-cart-btn flex ml-auto text-white bg-red-600 hover:bg-red-800 focus:ring-4 focus:outline-none focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center items-center dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800"
                            data-product={producto.nombre}
                            data-precio={producto.precio}
                            data-imagen={producto.imagen}
                            data-material={producto.material}
                            data-url={`/producto/${normalizarID(producto.nombre)}`}
                        >
                            <StrongIconCart />
                            <span class="button-text">Agregar</span>
                        </button>
                        <a
                            href={sendWhatsAppMessage()}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex text-white bg-green-600 hover:bg-green-700 focus:ring-4 focus:outline-none focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center items-center dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800"
                        >
                            <WhatsappIcon />
                            <span class="ml-2">Cotizar</span>
                        </a>
                    </div>
                </div>
            </div>
            <div
                class="lg:w-1/2 w-full lg:h-[400px] h-64 overflow-hidden rounded-lg"
            >
                <div id={carouselId} class="relative w-full h-full">
                    <!-- Carousel wrapper -->
                    <div class="relative h-full overflow-hidden rounded-lg">
                        {
                            producto.imagenes.map((imagen: any, index: any) => (
                                <div
                                    class="absolute w-full h-full transition-opacity duration-700 ease-in-out"
                                    data-carousel-item
                                    data-index={index}
                                >
                                    <Image
                                        src={imagen}
                                        alt={`${producto.nombre} - Imagen ${index + 1}`}
                                        class="absolute block w-full h-full object-cover"
                                        width={400}
                                        height={400}
                                    />
                                </div>
                            ))
                        }
                    </div>
                    <!-- Slider controls -->
                    <button
                        type="button"
                        class="absolute top-0 start-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
                        data-carousel-prev
                    >
                        <span
                            class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-red-600 group-hover:bg-red-700 group-focus:ring-4 group-focus:ring-red-500 group-focus:outline-none"
                        >
                            <svg
                                class="w-4 h-4 text-white rtl:rotate-180"
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 6 10"
                            >
                                <path
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 1 1 5l4 4"></path>
                            </svg>
                            <span class="sr-only">Anterior</span>
                        </span>
                    </button>
                    <button
                        type="button"
                        class="absolute top-0 end-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
                        data-carousel-next
                    >
                        <span
                            class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-red-600 group-hover:bg-red-700 group-focus:ring-4 group-focus:ring-red-500 group-focus:outline-none"
                        >
                            <svg
                                class="w-4 h-4 text-white rtl:rotate-180"
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 6 10"
                            >
                                <path
                                    stroke="currentColor"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="m1 9 4-4-4-4"></path>
                            </svg>
                            <span class="sr-only">Siguiente</span>
                        </span>
                    </button>
                    <!-- Indicators -->
                    <div
                        class="absolute z-30 flex space-x-3 -translate-x-1/2 bottom-5 left-1/2"
                    >
                        {
                            producto.imagenes.map((_: any, index: any) => (
                                <button
                                    type="button"
                                    class="w-3 h-3 rounded-full bg-white transition-colors duration-300 ease-in-out"
                                    aria-current="false"
                                    aria-label={`Slide ${index + 1}`}
                                    data-carousel-slide-to={index}
                                />
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<CartButton />

<script define:vars={{ carouselId }}>
    function initializeCarousel(carouselId) {
        const carousel = document.getElementById(carouselId);
        if (!carousel) return;

        const items = carousel.querySelectorAll("[data-carousel-item]");
        const prevButton = carousel.querySelector("[data-carousel-prev]");
        const nextButton = carousel.querySelector("[data-carousel-next]");
        const indicators = carousel.querySelectorAll(
            "[data-carousel-slide-to]",
        );
        let currentIndex = 0;

        function showItem(index) {
            items.forEach((item, i) => {
                if (i === index) {
                    item.classList.remove("opacity-0");
                    item.classList.add("opacity-100");
                } else {
                    item.classList.remove("opacity-100");
                    item.classList.add("opacity-0");
                }
            });

            // Update indicators
            indicators.forEach((indicator, i) => {
                if (i === index) {
                    indicator.classList.add("bg-red-600");
                    indicator.classList.remove("bg-white");
                    indicator.setAttribute("aria-current", "true");
                } else {
                    indicator.classList.remove("bg-red-600");
                    indicator.classList.add("bg-white");
                    indicator.setAttribute("aria-current", "false");
                }
            });
        }

        function nextItem() {
            currentIndex = (currentIndex + 1) % items.length;
            showItem(currentIndex);
        }

        function prevItem() {
            currentIndex = (currentIndex - 1 + items.length) % items.length;
            showItem(currentIndex);
        }

        nextButton.addEventListener("click", nextItem);
        prevButton.addEventListener("click", prevItem);

        // Add click event to indicators
        indicators.forEach((indicator, index) => {
            indicator.addEventListener("click", () => {
                currentIndex = index;
                showItem(currentIndex);
            });
        });

        // Mostrar el primer item
        showItem(currentIndex);
    }

    function initializeAllCarousels() {
        initializeCarousel(carouselId);
    }

    // Inicializar en la carga inicial y en navegaciones subsecuentes
    document.addEventListener("astro:page-load", initializeAllCarousels);
    document.addEventListener("astro:after-swap", initializeAllCarousels);
</script>
